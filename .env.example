# Environment variables
# Copy to .env and adjust as needed

# Required: Bearer token for /games endpoints and HMAC key for player tokens
API_TOKEN=secret-token

# Server port (default: 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# MongoDB connection string (default: mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name (default: tictactoe)
DB_NAME=tictactoe

# Game documents TTL in seconds via TTL index (default: 2592000 = 30 days)
DB_GAME_TTL=2592000
